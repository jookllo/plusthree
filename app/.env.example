APP_NAME=Plusthree
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=plusthree
DB_USERNAME=plusthree
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Transactional email through Resend. MAIL_MAILER=resend in production.
# MAIL_SENDER_ADDRESSES is a comma-separated list of verified senders; the
# composer shows a picker only when more than one is set.
RESEND_API_KEY=
MAIL_SENDER_ADDRESSES="${MAIL_FROM_ADDRESS}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Panel sign-in with Google. Only addresses in ADMIN_EMAILS may authenticate.
# The button is hidden while GOOGLE_LOGIN_ENABLED is false, even if credentials
# exist. Set it to true with both credentials to turn Google sign-in back on.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/mdosi/auth/google/callback"
ADMIN_EMAILS=

# Cheki analytics. On by default wherever APP_ENV is not local or testing, so
# production tracks without extra setup. Set ANALYTICS_ENABLED=false to keep a
# staging copy out of the same report.
# ANALYTICS_ENABLED=
ANALYTICS_HOST=https://cheki.plusthree.io
ANALYTICS_WEBSITE_ID=517fdb7f-a001-43a8-989f-75a6823dea18
